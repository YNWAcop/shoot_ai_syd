<?xml version="1.0"?>
<package format="2">
  <name>lingyun_bot</name>
  <version>1.0.0</version>
  <description>Shooting car mission using move_base, find_object_2d and ar_track_alvar.</description>
  <maintainer email="team@example.com">team</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>ar_track_alvar_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
</package>
