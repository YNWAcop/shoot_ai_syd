<launch>
  <node name="navigation_demo" pkg="robot_slam" type="shoot_new.py" output="screen">
      <rosparam command="load" file="$(find robot_slam)/params/competition_targets.yaml"/>
      <rosparam command="load" file="$(find robot_slam)/params/competition_tuning.yaml"/>
      <!-- <param name="goalListX" value="  0.92,  0.92,  0.9 , 0.28"/>
      <param name="goalListY" value=" -0.55,  -1.75, -2.95, -3.2"/>
      <param name="goalListYaw" value=" 0.0,   0.0 ,  0.0 ,  0.0 "/> -->
  </node>
</launch>
